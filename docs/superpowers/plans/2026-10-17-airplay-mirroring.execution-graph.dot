digraph airplay_linux {
  rankdir=LR;
  node [shape=box];
  subgraph cluster_foundation {
    label="foundation";
    "T-001" [label="Task 1: Establish packaging and freeze typed domain interfaces\nCapable"];
    "T-002" [label="Task 2: Supply deterministic adapters and a controllable event laboratory\nAdvanced"];
  }
  subgraph cluster_diagnostics {
    label="diagnostics";
    "T-003" [label="Task 3: Define safe diagnostics and user recovery messages\nStandard"];
  }
  subgraph cluster_storage {
    label="storage";
    "T-004" [label="Task 4: Implement durable non-secret records and continuity-aware preferences\nAdvanced"];
  }
  subgraph cluster_discovery {
    label="discovery";
    "T-005" [label="Task 5: Derive conservative receiver identities after cross-service aggregation\nCapable"];
    "T-006" [label="Task 6: Watch mDNS and expose domain discovery events\nAdvanced"];
  }
  subgraph cluster_process {
    label="process";
    "T-007" [label="Task 7: Implement bounded Linux process operations and exact ownership evidence\nAdvanced"];
    "T-008" [label="Task 8: Pin the published backend contract and capability negotiation\nCapable"];
    "T-009" [label="Task 9: Own a foreground daemon through supervisor and runtime reconciliation\nCapable"];
  }
  subgraph cluster_trust {
    label="trust";
    "T-010" [label="Task 10: Fence keyring trust transactions and compensate late pairing completion\nCapable"];
  }
  subgraph cluster_transport {
    label="transport";
    "T-011" [label="Task 11: Coordinate target-bound concurrent transport and sole-authority pairing\nCapable"];
  }
  subgraph cluster_capture {
    label="capture";
    "T-012" [label="Task 12: Enforce physical-monitor capture through portal and backend verification\nAdvanced"];
  }
  subgraph cluster_display {
    label="display";
    "T-013" [label="Task 13: Observe KScreen and launch version-checked owned virtual-monitor helpers\nAdvanced"];
    "T-014" [label="Task 14: Reserve and publish serialized KDE virtual-output creation\nCapable"];
    "T-015" [label="Task 15: Reconcile every ownership stage and remove outputs conservatively\nCapable"];
  }
  subgraph cluster_policy {
    label="policy";
    "T-016" [label="Task 16: Resolve receiver modes with reliable evidence and identity continuity\nStandard"];
    "T-017" [label="Task 17: Probe environment, audio, and per-mode capability gates\nAdvanced"];
  }
  subgraph cluster_session {
    label="session";
    "T-018" [label="Task 18: Serialize receiver actors and fence events by their actual resource\nCapable"];
    "T-019" [label="Task 19: Implement Mirror, pairing, mode confirmation, and universal ordered Stop\nCapable"];
    "T-020" [label="Task 20: Implement Virtual display, retained-output pairing, and resolution recreation\nCapable"];
    "T-021" [label="Task 21: Reconnect current targets and coordinate shared daemon recovery\nCapable"];
    "T-022" [label="Task 22: Preserve video through runtime audio loss and implement local mute\nAdvanced"];
    "T-023" [label="Task 23: Restore persisted intent, reconcile outputs, and bound shutdown\nCapable"];
  }
  subgraph cluster_ui {
    label="ui";
    "T-024" [label="Task 24: Project every resource combination into safe UI actions\nAdvanced"];
    "T-025" [label="Task 25: Build the dense PySide6 dashboard and accessible prompts\nAdvanced"];
    "T-026" [label="Task 26: Bind GUI intent to domain commands and safe asynchronous updates\nAdvanced"];
  }
  subgraph cluster_assembly {
    label="assembly";
    "T-027" [label="Task 27: Compose application startup, single-instance guard, and operator diagnostics\nCapable"];
  }
  subgraph cluster_adapter_acceptance {
    label="adapter-acceptance";
    "T-028" [label="Task 28: Exercise real adapter plumbing with private fake processes and opt-in environment checks\nAdvanced"];
  }
  subgraph cluster_lifecycle_acceptance {
    label="lifecycle-acceptance";
    "T-029" [label="Task 29: Verify every lifecycle transition and crash boundary through assembled sessions\nCapable"];
  }
  subgraph cluster_ui_acceptance {
    label="ui-acceptance";
    "T-030" [label="Task 30: Verify the full Qt state matrix and final runnable acceptance\nAdvanced"];
  }
