+	// A nil callback ignores the metadata.
+	OnSource func(SourceInfo)
+}
+
+// SourceInfo contains the metadata the portal reported for a selected stream.
+// These properties are optional at the portal boundary; the complete-source
+// producer below refuses partial identities. Metadata alone does not prove a
+// physical output's identity or ownership; callers must correlate it with their
+// compositor's outputs and reject ambiguous matches.
+type SourceInfo struct {
+	// Type is the portal's source_type value (0 = unknown, 1 = monitor,
+	// 2 = window, 4 = a virtual output created through the portal).
+	Type uint32 `json:"type"`
+	// Width and Height are compositor coordinates, which may differ from pixels.
+	Width  int `json:"width"`
+	Height int `json:"height"`
+	// X and Y are compositor coordinates, valid only when HasPosition is true.
+	X int `json:"x"`
+	Y int `json:"y"`
+	// HasPosition distinguishes an unknown position from a real (0,0) origin.
+	HasPosition bool `json:"has_position"`
+}
+
+// IsMonitor reports the portal's monitor classification. It does not prove
+// that the source is physical, belongs to the caller, or is the desired output.
+func (s SourceInfo) IsMonitor() bool { return s.Type == 1 }
+
+// portalStreamSource reads the identity properties the portal reports alongside
+// a stream. It returns false when the properties are absent or malformed, so a
+// caller can refuse an unverifiable capture rather than assume one.
+func portalStreamSource(properties map[string]dbus.Variant) (SourceInfo, bool) {
+	var info SourceInfo
+	if properties == nil {
+		return info, false
+	}
+	typeValue, ok := properties["source_type"]
+	if !ok {
+		return info, false
+	}
+	sourceType, ok := typeValue.Value().(uint32)
+	if !ok || sourceType == 0 {
+		return info, false
+	}
+	width, height, ok := portalStreamDimensions(properties)
+	if !ok || width <= 0 || height <= 0 {
+		return info, false
+	}
+	positionValue, ok := properties["position"]
+	if !ok {
+		return info, false
+	}
+	position, ok := positionValue.Value().([]interface{})
+	if !ok || len(position) != 2 {
+		return info, false
+	}
+	var x, y int
+	switch rawX := position[0].(type) {
+	case int32:
+		rawY, ok := position[1].(int32)
+		if !ok {
+			return info, false
+		}
+		x, y = int(rawX), int(rawY)
+	case int64:
+		rawY, ok := position[1].(int64)
+		if !ok {
+			return info, false
+		}
+		x, y = int(rawX), int(rawY)
+	default:
+		return info, false
+	}
+	info = SourceInfo{
+		Type: sourceType, Width: width, Height: height, X: x, Y: y, HasPosition: true,
+	}
+	return info, true
 }
 
