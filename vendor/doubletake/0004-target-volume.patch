 		c.encWriteNonce++
 
 		encrypted := c.encCipher.Seal(nil, nonce, chunk, aad)
 
 		result = append(result, aad...)
 		result = append(result, encrypted...)
 		chunkNum++
 	}
 	dbg("[ENC-WRITE] total: %d chunks, %d bytes output", chunkNum, len(result))
