+func parsePercent(value string) (int, error) {
+	invalid := fmt.Errorf("volume must be an integer from 0 to 100")
+	if len(value) < 1 || len(value) > 3 {
+		return 0, invalid
+	}
+	for i := 0; i < len(value); i++ {
+		if value[i] < '0' || value[i] > '9' {
+			return 0, invalid
+		}
+	}
+	percent, err := strconv.Atoi(value)
+	if err != nil || percent > 100 {
+		return 0, invalid
+	}
+	return percent, nil
+}
+
+func parseConnectArgs(args []string) (daemon.Request, error) {
+	req := daemon.Request{Cmd: "connect"}
+	invalid := fmt.Errorf("invalid connect arguments")
+	i := 0
+	if len(args) > 0 && !strings.HasPrefix(args[0], "-") {
+		if args[0] == "" {
+			return req, invalid
+		}
+		req.Target = args[0]
+		i++
+	}
+	credential := false
+	for i < len(args) {
+		value := args[i]
+		switch value {
+		case "--audio":
+			if credential || req.Audio != nil || req.Volume != nil {
+				return req, invalid
+			}
+			i++
+			if i == len(args) || (args[i] != "on" && args[i] != "off") {
+				return req, fmt.Errorf("audio must be on or off")
+			}
+			enabled := args[i] == "on"
+			req.Audio = &enabled
+		case "--volume":
+			if credential || req.Volume != nil {
+				return req, invalid
+			}
+			i++
+			operand := ""
+			if i < len(args) {
+				operand = args[i]
+			}
+			percent, err := parsePercent(operand)
+			if err != nil {
+				return req, err
+			}
+			req.Volume = &percent
+		default:
+			if credential || value == "" || strings.HasPrefix(value, "-") {
+				return req, invalid
+			}
+			req.Pin = value
+			credential = true
+		}
+		i++
+	}
+	return req, nil
+}
+
+func parseAudioArgs(args []string) (daemon.Request, error) {
+	req := daemon.Request{Cmd: args[0]}
+	if args[0] == "volume" {
+		if len(args) > 3 || (len(args) == 3 && (args[2] == "" || strings.HasPrefix(args[2], "-"))) {
+			return req, fmt.Errorf("Usage: doubletake-ctl volume <0-100> [target]")
+		}
+		operand := ""
+		if len(args) > 1 {
+			operand = args[1]
+		}
+		percent, err := parsePercent(operand)
+		if err != nil {
+			return req, err
+		}
+		req.Volume = &percent
+	} else {
+		if len(args) < 2 || len(args) > 3 || args[1] != "off" || (len(args) == 3 && (args[2] == "" || strings.HasPrefix(args[2], "-"))) {
+			return req, fmt.Errorf("Usage: doubletake-ctl audio off [target]")
+		}
+		enabled := false
+		req.Audio = &enabled
+	}
+	if len(args) == 3 {
+		req.Target = args[2]
+	}
+	return req, nil
+}
