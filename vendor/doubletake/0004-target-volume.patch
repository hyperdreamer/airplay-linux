 		}
 		data = data[len(chunk):]
 
 		nonce := make([]byte, 12)
 		binary.LittleEndian.PutUint64(nonce[4:], c.encWriteNonce)
 
 		aad := make([]byte, 2)
 		binary.LittleEndian.PutUint16(aad, uint16(len(chunk)))
 
