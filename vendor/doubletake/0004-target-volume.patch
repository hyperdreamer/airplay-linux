 		return d.handleSetMute(req, false)
+	case "volume":
+		return d.handleVolume(req)
+	case "audio":
+		return d.handleAudioOff(req)
 	default:
 		return Response{OK: false, Error: "unknown command: " + req.Cmd}
 	}
