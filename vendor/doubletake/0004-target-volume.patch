 		}
 	}
 
 	streamCfg := airplay.StreamConfig{
 		FPS:        *fps,
 		Bitrate:    *bitrate,
 		VideoCodec: airplay.VideoCodec(*videoCodec),
 		NoEncrypt:  *noEncrypt,
