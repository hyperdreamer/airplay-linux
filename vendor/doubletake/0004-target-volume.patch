 	lengthBuf := make([]byte, 2)
 	if _, err := io.ReadFull(c.conn, lengthBuf); err != nil {
 		return nil, fmt.Errorf("read frame length: %w (timeout or connection closed)", err)
 	}
 	plaintextLen := int(binary.LittleEndian.Uint16(lengthBuf))
