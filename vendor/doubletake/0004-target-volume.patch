 		"skipRecord": false,
 		"info": map[string]interface{}{
 			"displays": []interface{}{map[string]interface{}{
 				"widthPixels":     int64(1920),
 				"heightPixels":    int64(1080),
 				"widthPixelsMax":  int64(3840),
 				"heightPixelsMax": int64(2160),
 			}},
 		},
 	}, plist.BinaryFormat)
