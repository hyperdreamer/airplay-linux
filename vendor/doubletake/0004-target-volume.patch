 		body, headers, err := c.readEncryptedHTTPResponse()
 		return body, headers, markIncompleteResponse(err)
 	}
 	dbg("[READ] reading plaintext response")
 	body, headers, err := c.readPlaintextHTTPResponse()
 	return body, headers, markIncompleteResponse(err)
 }
 
