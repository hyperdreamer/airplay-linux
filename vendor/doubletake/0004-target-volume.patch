+// updateVolumeState is called with d.mu held, including final worker retirement.
+func updateVolumeState(entry *activeStream) {
+	switch {
+	case entry.volumeRunning || entry.volumeDesired != nil:
+		entry.volumeState = "pending"
+	case entry.audioClosed:
+		entry.volumeState = "unrequested"
+		if entry.volume != nil {
+			entry.volumeState = "applied"
+		}
+	case !entry.audioLevelReady:
+		entry.volumeState = "refused"
+	case entry.volume != nil:
+		entry.volumeState = "applied"
+	default:
+		entry.volumeState = "unrequested"
+	}
+}
