+func (d *Daemon) handleVolume(req Request) Response {
+	d.mu.Lock()
+	if req.Volume == nil || *req.Volume < 0 || *req.Volume > 100 || req.Audio != nil || req.Port != 0 || req.Pin != "" {
+		defer d.mu.Unlock()
+		return d.statusResponseLocked(false, "invalid volume request")
+	}
+	entries, message := d.audioTargetsLocked(req.Target, false)
+	if message == "" {
+		for _, entry := range entries {
+			if entry.audioClosed {
+				message = "audio is closed for this stream"
+				break
+			}
+			if d.shuttingDown || entry.state != StateStreaming || entry.session == nil || !entry.session.HasAudio() {
+				message = "audio control unavailable"
+				break
+			}
+		}
+	}
+	if message != "" {
+		defer d.mu.Unlock()
+		return d.statusResponseLocked(false, message)
+	}
+	requests := make([]*volumeRequest, len(entries))
+	sessions := make([]*airplay.MirrorSession, len(entries))
+	for i, entry := range entries {
+		entry.volumeSeq++
+		request := &volumeRequest{percent: *req.Volume, seq: entry.volumeSeq, result: make(chan string, 1)}
+		requests[i] = request
+		sessions[i] = entry.session
+		if entry.volumeDesired != nil {
+			entry.volumeDesired.result <- "superseded"
+		}
+		entry.volumeDesired = request
+		if !entry.volumeRunning {
+			entry.volumeContext, entry.volumeCancel = context.WithCancel(context.Background())
+			entry.volumeRunning = true
+			entry.volumeDone = make(chan struct{})
+			d.streamWorkers.Add(1)
+			go func(entry *activeStream) { defer d.streamWorkers.Done(); d.runVolume(entry) }(entry)
+		}
+		updateVolumeState(entry)
+	}
+	d.mu.Unlock()
+	for _, request := range requests {
+		result := <-request.result
+		if result != "acknowledged" && message == "" {
+			switch result {
+			case "superseded":
+				message = "volume request superseded"
+			case "closed":
+				message = "audio is closed for this stream"
+			case "rejected":
+				message = "receiver rejected volume"
+			default:
+				message = "volume update failed"
+			}
+		}
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	for i, entry := range entries {
+		if d.streams[entry.deviceIP] != entry || entry.session != sessions[i] {
+			message = "stream was replaced"
+		} else if entry.audioClosed && message == "" {
+			message = "audio is closed for this stream"
+		}
+	}
+	return d.statusResponseLocked(message == "", message)
+}
+
+func (d *Daemon) runVolume(entry *activeStream) {
+	var final *volumeRequest
+	var finalResult string
+	locked := false
+	defer func() {
+		if !locked {
+			d.mu.Lock()
+		}
+		entry.volumeRunning = false
+		entry.volumeCancel()
+		entry.volumeCancel = nil
+		updateVolumeState(entry)
+		close(entry.volumeDone)
+		d.mu.Unlock()
+		if final != nil {
+			final.result <- finalResult
+		}
+	}()
+	for {
+		d.mu.Lock()
+		request := entry.volumeDesired
+		entry.volumeDesired = nil
+		if request == nil {
+			locked = true
+			return
+		}
+		final = request
+		finalResult = "closed"
+		session := entry.session
+		current := d.streams[entry.deviceIP] == entry && session != nil && !entry.audioClosed && entry.volumeContext.Err() == nil
+		if !current {
+			locked = true
+			return
+		}
+		d.mu.Unlock()
+		err := session.SetAudioLevel(request.percent)
+		d.mu.Lock()
+		current = d.streams[entry.deviceIP] == entry && entry.session == session && !entry.audioClosed && entry.volumeContext.Err() == nil
+		if current && err == nil {
+			entry.volume = copyVolume(&request.percent)
+			entry.audioMuted = request.percent == 0
+			entry.audioLevelReady = true
+			finalResult = "acknowledged"
+		} else if current {
+			var status *airplay.HTTPStatusError
+			finalResult = "expired"
+			if errors.As(err, &status) {
+				finalResult = "rejected"
+			}
+		}
+		updateVolumeState(entry)
+		d.mu.Unlock()
+		if current && err == nil {
+			d.maybeStartAudio(entry)
+		}
+		d.mu.Lock()
+		current = d.streams[entry.deviceIP] == entry && entry.session == session && !entry.audioClosed && entry.volumeContext.Err() == nil
+		if !current {
+			finalResult = "closed"
+		}
+		if entry.volumeDesired == nil || !current {
+			locked = true
+			return
+		}
+		d.mu.Unlock()
+		request.result <- finalResult
+		final = nil
+	}
+}
