+		if err := json.Unmarshal(raw, &req); err != nil {
+			return Request{}, fmt.Errorf("invalid request: %w", err)
+		}
+		return req, nil
+	}
+	message := "invalid connect audio intent"
+	if cmd == "volume" {
+		message = "invalid volume request"
+	}
+	if cmd == "audio" {
+		message = "invalid audio request"
+	}
+	invalid := func() (Request, error) { return Request{}, errors.New(message) }
+	if cmd != "connect" && !newCommand {
+		return invalid()
+	}
+	if hasAudio && bytes.Equal(bytes.TrimSpace(fields["audio"]), []byte("null")) {
+		return invalid()
+	}
+	if hasVolume && bytes.Equal(bytes.TrimSpace(fields["volume"]), []byte("null")) {
+		return invalid()
+	}
+	var req Request
+	if err := json.Unmarshal(raw, &req); err != nil {
+		return invalid()
+	}
+	if req.Volume != nil && (*req.Volume < 0 || *req.Volume > 100) {
+		return invalid()
+	}
+	if newCommand {
+		if _, present := fields["port"]; present {
+			return invalid()
+		}
+		if _, present := fields["pin"]; present {
+			return invalid()
+		}
+	}
+	if cmd == "volume" && (!hasVolume || hasAudio) {
+		return invalid()
+	}
+	if cmd == "audio" && (!hasAudio || req.Audio == nil || *req.Audio || hasVolume) {
+		return invalid()
+	}
+	return req, nil
+}
