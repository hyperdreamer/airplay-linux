 	// exists; committing the pipeline earlier silently selects the 720p fallback.
 	captureCfg := airplay.CaptureConfig{
 		FPS:           *fps,
 		Bitrate:       *bitrate,
 		HWAccel:       *hwaccel,
 		VideoCodec:    airplay.VideoCodec(*videoCodec),
 		X11WindowID:   xid,
 		X11WindowName: *x11WindowName,
 		ShowCursor:    !*noCursor,
