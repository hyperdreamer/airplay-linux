 		return d.handleStatus()
 	case "discover":
 		return d.handleDiscover()
 	case "devices":
 		return d.handleDevices()
 	case "connect":
 		return d.handleConnect(req)
 	case "disconnect":
 		return d.handleDisconnect(req)
 	case "mute":
