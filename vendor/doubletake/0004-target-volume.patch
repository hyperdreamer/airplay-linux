+func (d *Daemon) maybeStartAudio(entry *activeStream) {
+	d.mu.Lock()
+	session := entry.session
+	if d.shuttingDown || d.streams[entry.deviceIP] != entry || entry.state != StateStreaming || session == nil ||
+		d.cfg.NoAudio || !session.HasAudio() || entry.audioClosed || !entry.audioLevelReady || entry.audioStarting || entry.audioCapture != nil {
+		d.mu.Unlock()
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	entry.audioStarting = true
+	entry.audioCancel = cancel
+	entry.audioDone = done
+	d.streamWorkers.Add(1)
+	d.mu.Unlock()
+	go func() {
+		defer d.streamWorkers.Done()
+		defer func() {
+			cancel()
+			d.mu.Lock()
+			if entry.audioDone == done {
+				entry.audioStarting = false
+				entry.audioCapture = nil
+				entry.audioCancel = nil
+			}
+			close(done)
+			d.mu.Unlock()
+		}()
+		capture, err := airplay.StartAudioCapture(ctx, d.cfg.TestMode, session.AudioCodec())
+		d.mu.Lock()
+		current := err == nil && capture != nil && d.streams[entry.deviceIP] == entry && entry.session == session &&
+			!entry.audioClosed && ctx.Err() == nil
+		if current {
+			entry.audioCapture = capture
+			entry.audioStarting = false
+		}
+		d.mu.Unlock()
+		if !current {
+			if capture != nil {
+				capture.Stop()
+			}
+			return
+		}
+		streamDone := make(chan struct{})
+		go func() { defer close(streamDone); _ = session.StreamAudio(ctx, capture, session.AudioStream()) }()
+		select {
+		case <-ctx.Done():
+		case <-streamDone:
+		}
+		cancel()
+		capture.Stop()
+		<-streamDone
+	}()
+}
+
+func (d *Daemon) handleAudioOff(req Request) Response {
+	deadline := time.Now().Add(2 * time.Second)
+	d.mu.Lock()
+	if req.Audio == nil || *req.Audio || req.Volume != nil || req.Port != 0 || req.Pin != "" {
+		defer d.mu.Unlock()
+		return d.statusResponseLocked(false, "invalid audio request")
+	}
+	entries, message := d.audioTargetsLocked(req.Target, true)
+	if message != "" {
+		defer d.mu.Unlock()
+		return d.statusResponseLocked(false, message)
+	}
+	sessions := make([]*airplay.MirrorSession, len(entries))
+	joins := make([]<-chan struct{}, len(entries))
+	var cancels []context.CancelFunc
+	for i, entry := range entries {
+		sessions[i] = entry.session
+		entry.audioClosed = true
+		if entry.volumeDesired != nil {
+			entry.volumeDesired.result <- "closed"
+			entry.volumeDesired = nil
+		}
+		if entry.audioCancel != nil {
+			cancels = append(cancels, entry.audioCancel)
+		}
+		if entry.volumeCancel != nil {
+			cancels = append(cancels, entry.volumeCancel)
+		}
+		joins[i] = entry.audioDone
+		updateVolumeState(entry)
+	}
+	d.mu.Unlock()
+	for _, cancel := range cancels {
+		cancel()
+	}
+	timer := time.NewTimer(max(time.Duration(0), time.Until(deadline)))
+	defer timer.Stop()
+	for _, done := range joins {
+		if done == nil {
+			continue
+		}
+		select {
+		case <-done:
+		case <-timer.C:
+			message = "audio close not confirmed"
+		}
+		if message != "" {
+			break
+		}
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	for i, entry := range entries {
+		if d.streams[entry.deviceIP] != entry || (sessions[i] != nil && entry.session != sessions[i]) {
+			message = "stream was replaced"
+		}
+		updateVolumeState(entry)
+	}
+	return d.statusResponseLocked(message == "", message)
+}
