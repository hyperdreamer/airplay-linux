+func (d *Daemon) audioTargetsLocked(target string, connecting bool) ([]*activeStream, string) {
+	if target != "" {
+		entry := d.streams[target]
+		if entry == nil {
+			return nil, "no active stream to " + target
+		}
+		return []*activeStream{entry}, ""
+	}
+	var entries []*activeStream
+	for _, entry := range d.streams {
+		if entry.state == StateStreaming || (connecting && (entry.state == StateConnecting || entry.state == StatePINRequired)) {
+			entries = append(entries, entry)
+		}
+	}
+	sort.Slice(entries, func(i, j int) bool { return entries[i].deviceIP < entries[j].deviceIP })
+	if len(entries) == 0 {
+		return nil, "not currently streaming"
+	}
+	return entries, ""
+}
