+// Source reports complete portal metadata retained by this preparation. It is
+// unavailable for the legacy capture path or when type, positive dimensions,
+// and both signed coordinates were not reported. Availability does not prove
+// physical output identity or ownership.
+func (p *CapturePreparation) Source() (SourceInfo, bool) {
+	if p == nil || !p.hasSource {
+		return SourceInfo{}, false
+	}
+	return p.source, true
+}
