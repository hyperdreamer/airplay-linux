@@ -393,6 +400,15 @@ func PrepareTestCapture(ctx context.Context, cfg CaptureConfig) (*CapturePrepara
 
 // Start launches the prepared encoder using the supplied nominal receiver
 // canvas. Zero dimensions leave the captured source at its native size.
+// Source reports only a complete source identity from the portal. It is
+// unavailable for the legacy capture path, or whenever 0001 could not prove
+// type, positive dimensions, and both signed coordinates.
+func (p *CapturePreparation) Source() (SourceInfo, bool) {
+	if p == nil || !p.hasSource {
+		return SourceInfo{}, false
+	}
+	return p.source, true
+}
+
 func (p *CapturePreparation) Start(width, height int) (*ScreenCapture, error) {
 	return p.startWithContextAndCodec(nil, width, height, "")
 }
